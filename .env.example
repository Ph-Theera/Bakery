# Copy URI from Supabase Dashboard > Connect (Session pooler for IPv4).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
HTTP_ADDR=127.0.0.1:8080
# Signing key (32+ random characters); no server-side session store is required.
AUTH_SECRET=
# Bearer token for trusted admin clients only. Never NEXT_PUBLIC_*.
ADMIN_API_TOKEN=
# Existing active app_schema.users UUID with role=admin.
ADMIN_USER_ID=
FRONTEND_ORIGIN=http://localhost:3000
# Base URL of your public product-image storage, ending before object_key.
PRODUCT_IMAGE_BASE_URL=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Notify the store owner after payment approval; LINE user or group ID.
LINE_ADMIN_USER_ID=
